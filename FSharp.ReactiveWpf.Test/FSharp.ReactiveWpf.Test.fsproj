<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>

        <IsPackable>false</IsPackable>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>false</UseWPF>
        <UseWindowsForms>False</UseWindowsForms>

    </PropertyGroup>

    <ItemGroup>
        <Compile Include="NumberParserTest.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.302" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />        
        <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
        <PackageReference Include="xunit.v3.core.mtp-v2" Version="3.2.2" />

        <PackageReference Include="FSharp.Idioms" Version="1.5.16" />
        <PackageReference Include="FSharp.xUnit" Version="1.3.0" />

    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FSharp.ReactiveWpf\FSharp.ReactiveWpf.fsproj" />
    </ItemGroup>


</Project>