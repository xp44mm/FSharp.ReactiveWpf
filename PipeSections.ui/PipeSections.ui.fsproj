<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>False</UseWindowsForms>

    <!-- 保持嵌入资源名称为 PipeSections.*.xaml，与 App.fs 中 "PipeSections." + filename 匹配 -->
    <RootNamespace>PipeSections</RootNamespace>

    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <PublishDir>bin\$(MSBuildProjectName)\</PublishDir>
    <CleanPublishFolder>true</CleanPublishFolder>
  </PropertyGroup>

  <!--
    XAML 文件从 Page 类型改为 EmbeddedResource（嵌入资源）：
    F# 没有 C# 的代码后置机制，默认的 Page 编译会尝试生成 .g.cs 导致编译错误；
    改为 EmbeddedResource 后 XAML 保持原始文件形式，由 App.fs 手动加载。
    一个 XAML 名称对应一个 .fs 名称（App.xaml -> App.fs、MainWindow.xaml -> MainWindow.fs）。
  -->
  <ItemGroup>
    <Page Remove="App.xaml" />
    <Page Remove="MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="App.xaml" />
    <EmbeddedResource Include="MainWindow.xaml" />
    <Compile Include="App.fs" />
    <Compile Include="Views\Row.fs" />
    <Compile Include="MainWindow.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.400" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Idioms" Version="1.5.17" />
    <PackageReference Include="FSharp.RfcJson" Version="0.0.4" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.ReactiveWpf\FSharp.ReactiveWpf.fsproj" />
    <ProjectReference Include="..\PipeSections.cli\PipeSections.cli.fsproj" />
  </ItemGroup>

</Project>
