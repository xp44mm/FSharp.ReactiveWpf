<metro:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
    Title="PipeSections"
    Width="680"
    Height="430"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="tbl"
            Margin="10"
            Orientation="Vertical">

            <!--  表头行  -->
            <StackPanel Orientation="Horizontal">
                <Border
                    Width="150"
                    Padding="5"
                    Background="#DDDDDD"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <TextBlock Text="直径" TextAlignment="Center" />
                </Border>
                <Border
                    Width="80"
                    Padding="5"
                    Background="#DDDDDD"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <TextBlock Text="周长" TextAlignment="Center" />
                </Border>
                <Border
                    Width="240"
                    Padding="5"
                    Background="#DDDDDD"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <TextBlock Text="截面积" TextAlignment="Center" />
                </Border>
                <Border
                    Width="160"
                    Padding="5"
                    Background="#DDDDDD"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <TextBlock Text="操作" TextAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- 添加项目按钮 -->
            <Button
                x:Name="addButton"
                Content="添加项目"
                Margin="0,5,0,0"
                Padding="8,3"
                HorizontalAlignment="Left" />

        </StackPanel>

    </ScrollViewer>



</metro:MetroWindow>
