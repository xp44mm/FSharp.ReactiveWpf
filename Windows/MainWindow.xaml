<metro:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
    Title="FSharp.ReactiveWpf test"
    Width="500"
    Height="400"
    WindowStartupLocation="CenterScreen">

    <StackPanel>
        <Button
            x:Name="stringButton"
            Margin="5"
            Content="string" />

        <Button
            x:Name="intButton"
            Margin="5"
            Content="int" />

        <Button
            x:Name="floatButton"
            Margin="5"
            Content="float" />

        <TextBlock
            x:Name="textBlock"
            Margin="5"
            Text="TextBlock" />

    </StackPanel>

</metro:MetroWindow>