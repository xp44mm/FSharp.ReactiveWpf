<metro:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
    Title="absorber"
    Width="1100"
    Height="500"
    WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <ToolBar VerticalAlignment="Center" DockPanel.Dock="Top">
            <Button
                x:Name="openFileButton"
                Content="打开..."
                DockPanel.Dock="Top" />
            <Button
                x:Name="saveFileButton"
                Content="保存..."
                DockPanel.Dock="Bottom" />
        </ToolBar>

        <TabControl>
            <TabItem Header="石灰石">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="limestone" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="大气">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="atmosphere" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="输入">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="gasInput" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="吸收塔">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="absorber" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="塔池">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="tower" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="吸收塔结果">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="towerResult" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="脱水系统">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="dewatering" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="烟气">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="gas" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="浆液">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="liquid" />
                </FlowDocumentScrollViewer>
            </TabItem>

            <TabItem Header="性能">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="performance" />
                </FlowDocumentScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>

</metro:MetroWindow>