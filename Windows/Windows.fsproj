<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>False</UseWindowsForms>
        <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
        <PublishDir>bin\$(MSBuildProjectName)\</PublishDir>
        <CleanPublishFolder>true</CleanPublishFolder>
    </PropertyGroup>

    <ItemGroup>
      <Page Remove="App.xaml" />
      <Page Remove="MainWindow.xaml" />
    </ItemGroup>


    <ItemGroup>
        <PackageReference Include="MahApps.Metro" Version="2.4.11" />
        <PackageReference Update="FSharp.Core" Version="10.1.302" />
        <PackageReference Include="FSharp.Idioms" Version="1.5.14" />
    </ItemGroup>

    
    <ItemGroup>
        <EmbeddedResource Include="App.xaml" />
        <EmbeddedResource Include="MainWindow.xaml" />
        <Compile Include="App.fs" />
        <Compile Include="MainWindow.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    
    <ItemGroup>
      <ProjectReference Include="..\FSharp.ReactiveWpf\FSharp.ReactiveWpf.fsproj" />
    </ItemGroup>

</Project>
